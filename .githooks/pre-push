#!/bin/sh
#
# Guard against pushing a change that would damage the live wiki.
#
# GitHub Pages deploys whatever reaches main, so a bad commit becomes the live
# site within a minute. This runs before anything leaves the machine.
#
# Override for a deliberate large change:
#     ALLOW_DESTRUCTIVE=1 git push
#
# Minimum share of docs files that must survive a push (percent).
SURVIVE_PCT=70

REPO_ROOT=$(git rev-parse --show-toplevel)
ZERO=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')

fail() {
    echo ""
    echo "  PUSH BLOCKED: $1"
    echo ""
    echo "  If this is intentional, re-run as:"
    echo "      ALLOW_DESTRUCTIVE=1 git push"
    echo ""
    exit 1
}

count_docs() {
    git ls-tree -r --name-only "$1" -- docs 2>/dev/null | grep -c . || echo 0
}

while read -r _local_ref local_sha remote_ref remote_sha; do
    # Nothing being pushed for this ref.
    [ "$local_sha" = "$ZERO" ] && {
        [ -n "$ALLOW_DESTRUCTIVE" ] || fail "this would DELETE the remote branch $remote_ref."
        continue
    }

    case "$remote_ref" in
        */main) ;;
        *) continue ;;   # only guard main
    esac

    # Compare against the remote tip when we actually have it locally.
    if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        before=$(count_docs "$remote_sha")
        after=$(count_docs "$local_sha")

        if [ "$before" -gt 0 ]; then
            threshold=$(( before * SURVIVE_PCT / 100 ))
            if [ "$after" -lt "$threshold" ]; then
                [ -n "$ALLOW_DESTRUCTIVE" ] || fail \
"docs file count drops $before -> $after (below ${SURVIVE_PCT}% of current)."
            fi
        fi
    fi

    # A push that cannot build is a push that breaks the live site.
    PY="$REPO_ROOT/.venv/Scripts/python.exe"
    [ -x "$PY" ] || PY="$REPO_ROOT/.venv/bin/python"
    if [ -x "$PY" ]; then
        echo "pre-push: verifying the site builds..."
        if ! "$PY" -m mkdocs build --strict --site-dir "$REPO_ROOT/.cache/prepush-site" >/dev/null 2>&1; then
            echo ""
            echo "  PUSH BLOCKED: 'mkdocs build --strict' fails."
            echo "  Run it yourself to see why:"
            echo "      .venv/Scripts/python.exe -m mkdocs build --strict"
            echo ""
            exit 1
        fi
        echo "pre-push: build OK."
    fi
done

exit 0
